# ===== One validator. Each teammate keeps their own copy on their own laptop. =====
# Copy to validator.env and fill in. NEVER commit or share this file.

VALIDATOR_NAME=Devesh's laptop

# From `npm run keygen`. Only YOU have this key.
VALIDATOR_KEY=0xYOUR_VALIDATOR_PRIVATE_KEY

# Use a DIFFERENT provider than your teammates, so one bad RPC can't fool everyone:
#   Validator 1: Alchemy   https://eth-sepolia.g.alchemy.com/v2/KEY   and https://polygon-amoy.g.alchemy.com/v2/KEY
#   Validator 2: Infura    https://sepolia.infura.io/v3/KEY           and https://polygon-amoy.infura.io/v3/KEY
#   Validator 3: Public    https://ethereum-sepolia-rpc.publicnode.com and https://rpc-amoy.polygon.technology
SOURCE_RPC=https://ethereum-sepolia-rpc.publicnode.com
DEST_RPC=https://rpc-amoy.polygon.technology

# Optional
CONFIRMATIONS=2
POLL_MS=4000
# If your RPC complains about "block range" limits, set a small value like 10 (it also auto-shrinks).
# LOG_CHUNK=2000
