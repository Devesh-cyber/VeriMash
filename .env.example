# ===== Deployer settings (only the person who deploys needs this file as .env) =====

# RPC URLs for the two chains. Free keys from alchemy.com or infura.io, or the public ones below.
CHAIN_A_RPC=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_B_RPC=https://rpc-amoy.polygon.technology

# Deployer wallet private key. Needs a little Sepolia ETH AND a little Amoy POL.
DEPLOYER_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# The 3 validator ADDRESSES (not keys!). Each teammate runs `npm run keygen` and sends you only the address.
VALIDATORS=0xAddressOfValidator1,0xAddressOfValidator2,0xAddressOfValidator3
VALIDATOR_NAMES=Devesh's laptop,Zeenat's laptop,Shivam's laptop
THRESHOLD=2

# Blocks to wait on Chain A before validators vote (protects against reorgs). 2 is fine for a demo.
CONFIRMATIONS=2

# Optional: RPCs the web app uses to read the chains (must allow browser CORS). Defaults are public RPCs.
# BROWSER_RPC_A=
# BROWSER_RPC_B=

# Optional, for `npm run attack` on testnets:
# ATTACKER_KEY=0xAnyWalletWithAmoyGas_NOT_a_validator
# ROGUE_VALIDATOR_KEY=0xOneValidatorKey
